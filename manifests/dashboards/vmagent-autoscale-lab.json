    {
      "id": 19,
      "type": "logs",
      "title": "prestop-drain lines",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "ClickHouse"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "ClickHouse"
          },
          "editorType": "sql",
          "format": 2,
          "queryType": "logs",
          "rawSql": "SELECT Timestamp AS timestamp, Body AS body, LogAttributes['k8s.pod.name'] AS pod\nFROM otel.otel_logs\nWHERE $__timeFilter(Timestamp)\n  AND LogAttributes['k8s.namespace.name'] = 'vmagent-lab'\n  AND (Body LIKE '%prestop-drain%' OR Body LIKE '%received signal%' OR Body LIKE '%closed fast persistent queue%' OR Body LIKE '%successfully stopped vmagent%')\nORDER BY Timestamp DESC\nLIMIT 500"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": []
